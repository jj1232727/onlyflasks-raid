# Copy this file to .env and paste the replacement key there.
# Never commit or share the value.
WOWAUDIT_API_KEY=
WOWAUDIT_BASE_URL=https://wowaudit.com
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Officer passphrase, the same one the board asks for. Only needed to read the
# /simc diagnostics, which are officer-gated because an export names a character,
# realm and full gear:  npm run simc:log
OFFICER_PASSPHRASE=
